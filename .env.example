# ==============================================================================
# JARVIS Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your credentials:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# NEVER commit your actual .env file or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot & Native VoIP Calling (Required)
# ------------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your numeric user ID from @userinfobot on Telegram
OWNER_ID=0
# Optional comma-separated list of additional Telegram user IDs permitted to talk to Jarvis
ALLOWED_USER_IDS=

# Optional Native 1-on-1 Telegram VoIP Calling (run `py setup_telegram_call.py` once to log in via QR code)
TELEGRAM_API_ID=2040
TELEGRAM_API_HASH=b18441a1ff607e10a989891a5462e627
TELEGRAM_CALL_SESSION=jarvis_call_userbot.session

# ------------------------------------------------------------------------------
# 2. Google Gemini & Gemma Models (Required)
# ------------------------------------------------------------------------------
# Get an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Primary & Fallback Models
LLM_MODEL=gemma-4-26b-a4b-it
LLM_FAST_MODEL=gemma-4-26b-a4b-it
LLM_DEEP_MODEL=gemma-4-26b-a4b-it
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# Adaptive Thinking Mode & Reliability Settings
LLM_THINKING_LEVEL=LOW
LLM_DEEP_THINKING_LEVEL=MEDIUM
LLM_TIMEOUT_SECONDS=45
LLM_PRIMARY_TIMEOUT_SECONDS=12
LLM_TEMPERATURE=0.4
LLM_MAX_OUTPUT_TOKENS=2048
GEMINI_RETRY_ATTEMPTS=3
GEMINI_FALLBACK_RETRIES=2
MAX_TOOL_STEPS=6

# ------------------------------------------------------------------------------
# 3. Personalization, Schedule & Desktop Overlay
# ------------------------------------------------------------------------------
USER_NAME=Sir
LOCATION=Dhaka
TIMEZONE=Asia/Dhaka
BRIEFING_TIME=06:40
EVENING_BRIEFING_TIME=21:30
BRIEFING_VOICE=true
BRIEFING_CALL=false

# Proactive background PC health alerts (battery, RAM, disk space)
PROACTIVE_ALERTS=true
BATTERY_ALERT_THRESHOLD=20

# Quiet hours window for non-urgent notifications (HH:MM)
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00

# Autonomous Student / Self-Learning Mode (studies topics on the web & takes Second Brain notes silently)
AUTO_STUDY_ENABLED=true
AUTO_STUDY_INTERVAL_HOURS=6
AUTO_STUDY_NOTIFY=false

# Dynamic Island Top-Notch Desktop Companion Overlay (Ctrl+/ = Chat Mode, Ctrl+Alt+Space = Voice Mode)
DESKTOP_OVERLAY_ENABLED=true
DESKTOP_OVERLAY_HOTKEY=ctrl+alt+space
DESKTOP_AUTO_SEE_DEFAULT=true
DESKTOP_VOICE_REPLY=false

# ------------------------------------------------------------------------------
# 4. Voice Transcription & Synthesis (MCU JARVIS)
# ------------------------------------------------------------------------------
# Optional: Groq Whisper for speech-to-text voice message transcription
GROQ_API_KEY=

# Voice Engine 1: Fish Audio (https://fish.audio - Recommended for free custom clone)
FISH_API_KEY=
FISH_MODEL_ID=
FISH_MODEL=s2.1-pro-free

# Voice Engine 2: ElevenLabs (Optional custom/community Paul Bettany clone)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL=eleven_multilingual_v2

# Voice Engine 3: Microsoft Edge-TTS (100% Free, Unlimited fallback)
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+5%
TTS_PITCH=-4Hz

# Default two-way Telegram voice mode (true = replies with voice notes aloud)
VOICE_CHAT_DEFAULT=true

# ------------------------------------------------------------------------------
# 5. Composio Universal Integration Bridge (Gmail, Calendar, Drive, GitHub, Notion, Slack, etc.)
# ------------------------------------------------------------------------------
# Add your single project API key from https://app.composio.dev/ once — connect any app via 1-click OAuth!
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
COMPOSIO_GMAIL_ACCOUNT=
COMPOSIO_GOOGLEDRIVE_ACCOUNT=
COMPOSIO_GOOGLECALENDAR_ACCOUNT=
COMPOSIO_TIMEOUT_SECONDS=25

# ------------------------------------------------------------------------------
# 6. Live Voice Call Server & Optional Twilio Phone Calls
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
MY_PHONE=
TWILIO_VOICE=Polly.Brian
TWILIO_WEBHOOK_URL=
TWILIO_WEBHOOK_HOST=0.0.0.0
TWILIO_WEBHOOK_PORT=8787
TWILIO_WEBHOOK_ENABLED=true
TWILIO_USE_CUSTOM_TTS=true

# ------------------------------------------------------------------------------
# 7. Local Storage, Backups & Knowledge Vault Paths
# ------------------------------------------------------------------------------
INBOX_DIR=inbox
KNOWLEDGE_LOCAL_DIR=notes
KNOWLEDGE_DRIVE_FOLDER=
DB_PATH=jarvis.db
BACKUP_DIR=backups
BACKUP_TIME=03:30
BACKUP_KEEP=7
LOG_FILE=jarvis.log
LOG_LEVEL=INFO
